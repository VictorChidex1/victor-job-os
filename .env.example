# Victor's Job OS — Frontend environment variables
#
# Env files are split by Vite mode:
#   .env               → shared Firebase web-app client config (loaded in ALL modes)
#   .env.development   → emulator toggle for `npm run dev`
#   .env.production    → emulator toggle for `npm run build`
#
# Copy .env.example to .env and fill in values from your Firebase project
# (Project settings → General → Your apps → Web app → SDK setup).
# Firebase client config is intentionally public per Firebase architecture.
# Privileged credentials (service accounts, AI/email/ATS secrets) MUST stay
# server-side in Cloud Functions and must NEVER be added here.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- .env.development (local dev against emulators) ---
# VITE_FIREBASE_EMULATOR=true
# VITE_FIREBASE_AUTH_EMULATOR_PORT=9099
# VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8080

# --- .env.production (production build against real Firebase) ---
# VITE_FIREBASE_EMULATOR=false