rules_version = '2';

// Victor's Job OS — Firestore security rules
//
// Multi-user application. Every user-owned document carries a `userId` field
// (or is keyed by the user's UID) and is readable/writable only by its owner.
// The real security boundary is these rules, not UI checks.

service cloud.firestore {
  match /databases/{database}/documents {
    // Deny everything else by default (least privilege).
    match /{document=**} {
      allow read, write: if false;
    }

    function signedIn() {
      return request.auth != null;
    }

    // Documents keyed by the authenticated user's UID.
    function isOwnerId(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Documents carrying a `userId` field owned by the authenticated user.
    function ownsUserField(data) {
      return signedIn() && data.userId == request.auth.uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // Owned documents keyed by the authenticated user's UID.
    match /users/{uid} {
      allow read: if isOwnerId(uid) || isAdmin();
      allow create: if isOwnerId(uid) && request.resource.data.role == 'user';
      allow update: if isAdmin() || (
        isOwnerId(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid'])
      );
      allow delete: if isAdmin();
    }

    match /profiles/{uid} {
      allow read: if isOwnerId(uid) || isAdmin();
      allow write: if isOwnerId(uid);
    }

    match /settings/{uid} {
      allow read: if isOwnerId(uid) || isAdmin();
      allow write: if isOwnerId(uid);
    }

    // User-owned collections scoped by a `userId` field.
    match /projects/{documentId} {
      allow read: if ownsUserField(resource.data) || isAdmin();
      allow delete: if ownsUserField(resource.data);
      allow create: if ownsUserField(request.resource.data);
      allow update: if ownsUserField(resource.data) && ownsUserField(request.resource.data);
    }

    match /resumeVariants/{documentId} {
      allow read: if isAdmin() || (signedIn() && (resource == null || ownsUserField(resource.data)));
      allow delete: if ownsUserField(resource.data);
      allow create: if ownsUserField(request.resource.data);
      allow update: if ownsUserField(resource.data) && ownsUserField(request.resource.data);
    }

    match /jobSources/{documentId} {
      allow read: if ownsUserField(resource.data) || isAdmin();
      allow delete: if ownsUserField(resource.data);
      allow create: if ownsUserField(request.resource.data);
      allow update: if ownsUserField(resource.data) && ownsUserField(request.resource.data);
    }

    match /jobs/{documentId} {
      allow read: if ownsUserField(resource.data) || isAdmin();
      allow delete: if ownsUserField(resource.data);
      allow create: if ownsUserField(request.resource.data);
      allow update: if ownsUserField(resource.data) && ownsUserField(request.resource.data);
    }

    match /companies/{documentId} {
      allow read: if ownsUserField(resource.data) || isAdmin();
      allow delete: if ownsUserField(resource.data);
      allow create: if ownsUserField(request.resource.data);
      allow update: if ownsUserField(resource.data) && ownsUserField(request.resource.data);
    }

    match /jobAnalyses/{documentId} {
      allow read: if ownsUserField(resource.data) || isAdmin();
      allow delete: if ownsUserField(resource.data);
      allow create: if ownsUserField(request.resource.data);
      allow update: if ownsUserField(resource.data) && ownsUserField(request.resource.data);
    }

    match /outreach/{documentId} {
      allow read: if ownsUserField(resource.data) || isAdmin();
      allow delete: if ownsUserField(resource.data);
      allow create: if ownsUserField(request.resource.data);
      allow update: if ownsUserField(resource.data) && ownsUserField(request.resource.data);
    }

    // Applications are the V2 execution records. A deterministic document id
    // means clients may probe for an existing application before creating it,
    // so reads of a missing document are allowed for signed-in users.
    match /applications/{documentId} {
      allow read: if isAdmin() || (signedIn() && (resource == null || ownsUserField(resource.data)));
      allow delete: if ownsUserField(resource.data);
      allow create: if ownsUserField(request.resource.data);
      allow update: if ownsUserField(resource.data) && ownsUserField(request.resource.data);
    }

    // Application timeline entries are immutable: no edits. Owners may delete
    // them only as part of deleting the parent application.
    match /applicationEvents/{documentId} {
      allow read: if ownsUserField(resource.data) || isAdmin();
      allow delete: if ownsUserField(resource.data);
      allow create: if ownsUserField(request.resource.data);
      allow update: if false;
    }

    // Preparation content is separate from the application record so the
    // pipeline list stays lightweight. A deterministic uid-prefixed id keeps
    // preparation documents isolated even if another user knows an app id.
    match /applicationPreparations/{documentId} {
      allow read: if isAdmin() || (signedIn() && (resource == null || ownsUserField(resource.data)));
      allow delete: if signedIn() && (resource == null || ownsUserField(resource.data));
      allow create: if ownsUserField(request.resource.data);
      allow update: if ownsUserField(resource.data) && ownsUserField(request.resource.data);
    }

    match /contacts/{documentId} {
      allow read: if ownsUserField(resource.data) || isAdmin();
      allow delete: if ownsUserField(resource.data);
      allow create: if ownsUserField(request.resource.data);
      allow update: if ownsUserField(resource.data) && ownsUserField(request.resource.data);
    }

    match /followUps/{documentId} {
      allow read: if ownsUserField(resource.data) || isAdmin();
      allow delete: if ownsUserField(resource.data);
      allow create: if ownsUserField(request.resource.data);
      allow update: if ownsUserField(resource.data) && ownsUserField(request.resource.data);
    }

    match /activityLogs/{documentId} {
      allow read: if ownsUserField(resource.data) || isAdmin();
      allow delete: if ownsUserField(resource.data);
      allow create: if ownsUserField(request.resource.data);
      allow update: if ownsUserField(resource.data) && ownsUserField(request.resource.data);
    }

    match /aiRuns/{documentId} {
      allow read: if ownsUserField(resource.data) || isAdmin();
      allow write: if false;
    }

    // Client-reported errors: a user may create and read their own records.
    // Only the Cloud Functions (admin SDK, bypasses rules) may modify them.
    match /errorLogs/{documentId} {
      allow read: if ownsUserField(resource.data);
      allow create: if ownsUserField(request.resource.data);
      allow update, delete: if false;
    }
  }
}
