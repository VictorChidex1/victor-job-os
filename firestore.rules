rules_version = '2';

// Victor's Job OS — Firestore security rules
// Phase 1 placeholder: deny by default. Full least-privilege rules for the
// V1 collections (profiles, jobs, companies, jobAnalyses, projects, outreach,
// contacts, followUps, applications, settings, activityLogs, aiRuns) are
// implemented in Phase 3 (ProjectOverview execution roadmap, step 20).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}