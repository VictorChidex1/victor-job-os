# Victor's Job OS — Cloud Functions environment (server-side secrets)
#
# Copy to functions/.env for local emulator use, and set the same values in
# Cloud Functions config when deployed. Never commit the real .env file.

# --- Browser automation ---
# mock | playwright (local emulator) | cloud-run (production worker)
AUTOMATION_PROVIDER=mock
# Required when AUTOMATION_PROVIDER=cloud-run
BROWSER_WORKER_URL=

# Production project-specific variables belong in functions/.env.victor-job-os:
# AUTOMATION_PROVIDER=cloud-run
# BROWSER_WORKER_URL=https://...

# --- Firebase Storage ---
# Optional explicit bucket override. In production Functions normally derives
# this from FIREBASE_CONFIG. The local emulator uses 127.0.0.1:9199.
# STORAGE_BUCKET=victor-job-os.firebasestorage.app

# --- AI provider ---
# Which provider the AI service uses: "gemini" (default) or "openai".
AI_PROVIDER=gemini

# --- Gemini (Google) ---
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the primary Gemini model (default: gemini-3.5-flash)
GEMINI_MODEL=
# Optional: model used automatically on quota (429) or retired-model (404)
# errors (default: gemini-3.1-flash-lite)
GEMINI_FALLBACK_MODEL=

# --- OpenAI (optional second provider) ---
# Get a key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: override the OpenAI model (default: gpt-4o-mini)
OPENAI_MODEL=
