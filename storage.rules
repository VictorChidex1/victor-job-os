rules_version = '2';

// Automation screenshots are private, owner-scoped, and written only by
// trusted Cloud Functions using the Admin SDK.
service firebase.storage {
  match /b/{bucket}/o {
    match /automation/{userId}/{runId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
